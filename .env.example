# Copy to .env and fill in your values (never commit .env)
#
# ── Primary LLM: Groq (OpenAI-compatible API) ──────────────────────────────
# Sign up at https://console.groq.com → API Keys → Create key
LLM_PROVIDER=openai
OPENAI_API_KEY=your_groq_api_key_here
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_MODEL=llama-3.3-70b-versatile
#
# ── Optional Gemini fallback (only used when Groq returns 429 / error) ─────
# Get a key at https://aistudio.google.com/apikey
# Set LLM_GROQ_FALLBACK_GEMINI=1 (default) AND provide GEMINI_API_KEY.
# If both Groq and Gemini fail, the system returns the raw RAG chunk text.
LLM_GROQ_FALLBACK_GEMINI=1
GEMINI_API_KEY=your_gemini_api_key_here_or_leave_blank
GEMINI_MODEL=gemini-2.0-flash-lite
#
# ── No LLM (RAG chunks only) ───────────────────────────────────────────────
# LLM_PROVIDER=none
#
# ── Optional tuning (defaults shown) ───────────────────────────────────────
# LLM_CONTEXT_MAX_CHARS=2400
# LLM_MAX_TOKENS=600
