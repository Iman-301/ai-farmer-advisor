# Copy to .env and fill in your values (never commit .env)
#
# ── Primary LLM: Gemini (fast) with Groq fallback ────────────────────────────
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash
LLM_GEMINI_FALLBACK_GROQ=1
OPENAI_API_KEY=your_groq_api_key_here
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_MODEL=llama-3.3-70b-versatile
#
# ── Voice latency tuning ───────────────────────────────────────────────────
# Voice: Gemini synthesizes answer; compose/chunks only if LLM fails
RAG_VOICE_LLM_FIRST=1
RAG_VOICE_COMPOSE_FIRST=0
RAG_VOICE_LLM_MAX_TOKENS=450
RAG_VOICE_PG_FINAL_K=3
RAG_VOICE_RAG_ANSWER_MAX_CHARS=600
RAG_RESPONSE_CACHE_TTL_SEC=120
#
# TTS: gTTS via Google (requires internet; ~2-4s per sentence)
TTS_PROVIDER=gtts
TTS_ATEMPO=1.15
TTS_MAX_CHARS=400
#
# VAD orchestrator (phone_gateway/docker-compose.yml)
VOICE_ASK_ENABLED=0
VAD_TTS_CHUNK_MAX_CHARS=140
VAD_TTS_MAX_CHARS=400
MAX_CONCURRENT_ASR=2
VAD_END_SILENCE_MS=520
#
# ── Optional tuning ────────────────────────────────────────────────────────
# LLM_MAX_TOKENS=1500
# LLM_PRESENCE_PENALTY=0.6
# LLM_FREQUENCY_PENALTY=0.5
# RAG_PG_CANDIDATE_K=24
# RAG_PG_FINAL_K=6
# RAG_MIN_BEST_DISTANCE=1.05
# WHISPER_BEAM_SIZE=1
# WHISPER_TIMEOUT_S=30
